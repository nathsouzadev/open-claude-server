# --- Slack integration ---
# Set SLACK_ENABLED=true and populate SLACK_BOTS to spin up the multi-bot Bolt app.
# Each bot maps to an agent file in <WORKSPACE>/claude-config/agents/<agent>.md
SLACK_ENABLED=false
SLACK_BOTS=[
  {"name":"example-bot","botToken":"xoxb-REPLACE-ME","appToken":"xapp-1-REPLACE-ME","agent":"example"}
]

# --- HTTP server ---
NODE_ENV=production
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# --- auth & rate limit (OFF by default — turn on before exposing the port) ---
AUTH_ENABLED=false
API_TOKEN=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CORS_ORIGIN=*

# --- Claude CLI runtime ---
CLAUDE_BIN=claude
CLAUDE_CWD=/workspace/projects
CLAUDE_TIMEOUT_MS=120000
CLAUDE_MAX_INPUT_CHARS=50000
CLAUDE_MAX_CONCURRENCY=3
CLAUDE_QUEUE_MAX_WAIT_MS=30000

# --- GitHub (used by agents that hit gh CLI / git) ---
GH_TOKEN=
GITHUB_TOKEN=
