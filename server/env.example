# Copy to server/.env (rename to dotfile) and fill in. server/.env is gitignored.

# --- HTTP server ---
NODE_ENV=production
LOG_LEVEL=info
SERVER_PORT=3010

# --- Auth (turn ON before exposing publicly) ---
AUTH_ENABLED=false
API_TOKEN=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- CORS (restrict before exposing) ---
CORS_ORIGIN=*

# --- Claude CLI ---
CLAUDE_BIN=claude
CLAUDE_CWD=/workspace/projects
CLAUDE_TIMEOUT_MS=120000
CLAUDE_MAX_INPUT_CHARS=50000

# --- Slack bot (optional) ---
# SLACK_ENABLED=true
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_AGENT=my-agent
