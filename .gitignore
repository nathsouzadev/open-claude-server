# OS
.DS_Store

# Secrets & env (root-level catch-all)
.env
.env.local
**/.env
**/.env.local
!**/.env.example

# Docker overrides
docker-compose.override.yml
**/docker-compose.override.yml
docker/.env

# Server
server/node_modules/
server/.env
server/npm-debug.log*
server/dist/
server/data/

# Host-mode bridge runtime files
.host-claude-worker.pid
.host-claude-worker.log

# Workspace mounts — the example template (workspace/claude-workspace-example/)
# is committed; the bootstrapped copy (workspace/claude-workspace/) is gitignored.
workspace/claude-workspace/

# Claude Code credentials (defense in depth)
**/.credentials.json
**/.credentials
