# OS
.DS_Store

# Secrets & env (root-level catch-all)
.env
.env.local
**/.env
**/.env.local
!**/.env.example

# Docker overrides
docker-compose.override.yml
**/docker-compose.override.yml
docker/.env

# Server
server/node_modules/
server/.env
server/npm-debug.log*
server/dist/
server/data/

# Workspace mounts — users point WORKSPACE_DIR at their private workspace repo.
# The example template is committed; anything else under workspace/ is ignored.
workspace/*
!workspace/claude-workspace.example/
workspace/claude-workspace.example/projects/*/
workspace/claude-workspace.example/claude-config/.credentials*
workspace/claude-workspace.example/claude-config/auth*
workspace/claude-workspace.example/claude-config/sessions/
workspace/claude-workspace.example/claude-config/cache/
workspace/claude-workspace.example/claude-config/shell-snapshots/
workspace/claude-workspace.example/claude-config/statsig/
workspace/claude-workspace.example/claude-config/todos/

# Claude Code credentials (defense in depth)
**/.credentials.json
**/.credentials
