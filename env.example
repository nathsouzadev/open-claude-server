# --- claude-server runtime ---
# Path to your private workspace repo (claude-config, skills, projects).
# Created from ./workspace/claude-workspace-example by `scripts/init.sh`.
WORKSPACE_DIR=./workspace/claude-workspace

# Per-project auto-memory dir on the host. Defaults to a path encoded from
# CLAUDE_CWD=/workspace/projects; override if your host setup differs.
# PROJECT_MEMORY_HOST_DIR=${HOME}/.claude/projects/-workspace-projects/memory

# --- secrets ---
# Global GitHub token. Used by any agent without a per-agent override (below)
# and by the host `gh` CLI. Scopes: `repo` (+ `read:project` for Projects v2).
GH_TOKEN=

# Per-agent GitHub token overrides (optional). Slug = agent name in
# UPPER_SNAKE_CASE. Set only the agents that need a dedicated identity; the
# rest fall back to GH_TOKEN. Full reference in README §"GitHub tokens".
# GH_TOKEN_DOROTHY=
# GH_TOKEN_NANISCA=
# GH_TOKEN_ADA=
# GH_TOKEN_KATHERINE=

API_TOKEN=

# --- tuning ---
SERVER_PORT=3010
NODE_ENV=production
LOG_LEVEL=info
AUTH_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CORS_ORIGIN=*

CLAUDE_BIN=claude
CLAUDE_CWD=/workspace/projects
CLAUDE_TIMEOUT_MS=120000
CLAUDE_MAX_INPUT_CHARS=50000
CLAUDE_MAX_CONCURRENCY=3
CLAUDE_QUEUE_MAX_WAIT_MS=30000

# --- Mode B only (claude CLI on host) ---
# Generate once: openssl rand -hex 24
CLAUDE_WORKER_TOKEN=
CLAUDE_WORKER_PORT=3011

# --- container limits ---
SERVER_MEM_LIMIT=4g
SERVER_MEM_RESERVATION=512m
SERVER_PIDS_LIMIT=256

# UID/GID alignment for bind mounts (macOS default = 501)
USER_UID=501
USER_GID=501
